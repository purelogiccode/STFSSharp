<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>StfsSharp</AssemblyName>
    <RootNamespace>StfsSharp</RootNamespace>

    <!-- NuGet metadata. Version comes from git tags via MinVer. -->
    <IsPackable>true</IsPackable>
    <PackageId>StfsSharp</PackageId>
    <Title>StfsSharp</Title>
    <Description>Read-only .NET library for Xbox 360 STFS packages and GOD/SVOD containers. Lists and extracts XBLA/XBLIG/Community Games packages, validates the STFS SHA-1 hash tree, reads XContent title metadata, and exposes GOD fragment sets as a seekable stream. Zero dependencies, trimmable and AOT-compatible.</Description>
    <PackageTags>stfs;god;svod;xcontent;xbox;xbox-360;xbla;xblig;package;disc-image;emulation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <MinClientVersion>5.0</MinClientVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- This library groups closely related records and keeps the hot block
         read/validate loops inline; split them when the public surface
         stabilizes. -->
    <NoWarn>$(NoWarn);MA0048;MA0051</NoWarn>

    <!-- Trimming and AOT compatibility -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Source Link + reproducible builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedAllSources>true</EmbedAllSources>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Package output -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.321">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>StfsSharp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
